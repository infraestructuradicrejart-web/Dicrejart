# Copia este archivo a ".env" (mismo folder) y llena los valores reales.
# NUNCA subas el .env real ni service-account.json a git (ya están en .gitignore).

# API local de DSM — el agente corre EN el NAS, así que es localhost. No usar QuickConnect aquí.
NAS_LOCAL_URL=http://localhost:5000

# URL pública de QuickConnect — SOLO se usa para armar el link que la gente abre en su
# navegador (ese sí funciona con QuickConnect, porque un navegador real ejecuta el
# JavaScript de negociación que QuickConnect necesita).
NAS_PUBLIC_URL=https://gpodicrejartnas.quickconnect.to

# Cuenta dedicada de Synology (permiso de escritura SOLO en NAS_ROOT_PATH, nunca la cuenta admin)
NAS_USER=
NAS_PASS=

# Carpeta compartida raíz donde se organizan las evidencias
NAS_ROOT_PATH=/evidencias

# Bucket de Firebase Storage del proyecto (Firebase Console → Storage, arriba dice "gs://...")
FIREBASE_STORAGE_BUCKET=dicrejartapp.firebasestorage.app

# Ruta al archivo de la clave de cuenta de servicio (ver README.md) — relativa a esta carpeta
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
